# Gemini API Key
# Получите ваш API ключ здесь: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini Tier (опционально, по умолчанию 'free')
# Возможные значения: free, tier1
# Определяет лимиты запросов и доступные функции
# Free tier: RPM 2-15, генерация изображений НЕДОСТУПНА, аудио генерация 3 RPM
# Tier1: RPM 150-4000, генерация изображений доступна, аудио генерация 10 RPM
GEMINI_TIER="free"
